+//! Disposable candidate regressions: independent counter bytes and final-state model.
+use ic_db::{Batch, Database, Entity, Error, Schema, SchemaCopy, SchemaTransition, entity};
+use ic_storage::{
+    AllocationGrants, GenericAllocationPolicy, MemoryAuthority, MemoryRequest, MemoryRuntime,
+    SealedDeclarationSnapshot, StableKey, VectorMemory, adapter::StableBTreeMap,
+};
+#[entity(name="Row",pk(field="id"),index(fields=["category","id"]),index(field="score",unique),fields(
+ field(name="id",value(item(prim="Nat64"))),field(name="category",value(item(prim="Nat64"))),field(name="score",value(item(prim="Nat64")))
+))]
+struct Row {}
+#[entity(name="Row",pk(field="id"),index(fields=["category","id"]),index(field="score",unique),fields(
+ field(name="id",value(item(prim="Nat64"))),field(name="category",value(item(prim="Nat64"))),field(name="score",value(item(prim="Nat128")))
+))]
+struct Wide {}
+fn schema() -> Schema {
+    Schema::new(&[Row::SCHEMA]).unwrap()
+}
+fn key(target: bool) -> StableKey {
+    StableKey::parse(if target {
+        "test.target.v1"
+    } else {
+        "test.source.v1"
+    })
+    .unwrap()
+}
+fn host(memory: VectorMemory) -> MemoryRuntime<VectorMemory> {
+    let mut h = MemoryRuntime::new(memory).unwrap();
+    h.bootstrap(
+        &SealedDeclarationSnapshot::new(vec![
+            MemoryRequest::new("test", "test.source.v1").unwrap(),
+            MemoryRequest::new("test", "test.target.v1").unwrap(),
+        ])
+        .unwrap(),
+        &AllocationGrants::new(vec![MemoryAuthority::new("test", "test.").unwrap()]).unwrap(),
+        &GenericAllocationPolicy,
+    )
+    .unwrap();
+    h
+}
+fn create(h: &MemoryRuntime<VectorMemory>) -> Database<VectorMemory> {
+    Database::create(h.open_memory(&key(false)).unwrap(), schema(), [1; 16]).unwrap()
+}
+fn count(db: &Database<VectorMemory>, category: u64) -> u64 {
+    db.prefix_cardinality::<Row>("category,id", &[category.into()])
+        .unwrap()
+}
+fn raw_key(category: u64) -> Vec<u8> {
+    let mut k = vec![4];
+    k.extend(Row::ID.to_be_bytes());
+    k.extend(
+        Row::SCHEMA
+            .indexes
+            .iter()
+            .find(|i| i.name == "category,id")
+            .unwrap()
+            .id
+            .to_be_bytes(),
+    );
+    k.extend(category.to_be_bytes());
+    k
+}
+fn counters(h: &MemoryRuntime<VectorMemory>, target: bool) -> Vec<(Vec<u8>, Vec<u8>)> {
+    let map =
+        StableBTreeMap::<Vec<u8>, Vec<u8>, _>::load(h.open_memory(&key(target)).unwrap());
+    map.range(vec![4]..vec![5])
+        .map(|entry| (entry.key().clone(), entry.value()))
+        .collect()
+}
+#[test]
+fn final_state_deltas_noops_refusals_and_reopen() {
+    let memory = VectorMemory::default();
+    let h = host(memory.clone());
+    let mut db = create(&h);
+    let mut batch = Batch::new();
+    for id in 1..=3 {
+        batch
+            .insert(&Row {
+                id,
+                category: 1,
+                score: id,
+            })
+            .unwrap();
+    }
+    db.commit(batch).unwrap();
+    assert_eq!((count(&db, 1), count(&db, 2)), (3, 0));
+    let mut b = Batch::new();
+    b.replace(&Row {
+        id: 1,
+        category: 2,
+        score: 2,
+    })
+    .unwrap();
+    b.replace(&Row {
+        id: 2,
+        category: 1,
+        score: 1,
+    })
+    .unwrap();
+    db.commit(b).unwrap();
+    assert_eq!((count(&db, 1), count(&db, 2)), (2, 1));
+    for refused in 0..4 {
+        let before = memory.borrow().clone();
+        let mut b = Batch::new();
+        match refused {
+            0 => {
+                b.replace(&Row {
+                    id: 1,
+                    category: 2,
+                    score: 2,
+                })
+                .unwrap();
+            }
+            1 => {
+                b.insert(&Row {
+                    id: 4,
+                    category: 99,
+                    score: 3,
+                })
+                .unwrap();
+            }
+            2 => {
+                b.insert(&Row {
+                    id: 4,
+                    category: 99,
+                    score: 4,
+                })
+                .unwrap();
+                b.delete::<Row>(999).unwrap();
+            }
+            _ => {
+                b.delete::<Row>(1).unwrap();
+                b.delete::<Row>(1).unwrap();
+            }
+        }
+        let result = db.commit(b);
+        if refused == 0 {
+            result.unwrap();
+        } else {
+            assert!(result.is_err());
+        }
+        assert_eq!(*memory.borrow(), before);
+    }
+    let mut b = Batch::new();
+    b.delete::<Row>(1).unwrap();
+    b.insert(&Row {
+        id: 4,
+        category: 2,
+        score: 4,
+    })
+    .unwrap();
+    db.commit(b).unwrap();
+    assert_eq!(count(&db, 2), 1);
+    let mut b = Batch::new();
+    b.delete::<Row>(4).unwrap();
+    db.commit(b).unwrap();
+    assert_eq!(count(&db, 2), 0);
+    drop(db);
+    assert_eq!(
+        counters(&h, false),
+        vec![(raw_key(1), 2_u64.to_le_bytes().to_vec())]
+    );
+    drop(h);
+    let h = host(memory);
+    let db = Database::open(h.open_memory(&key(false)).unwrap(), schema()).unwrap();
+    assert_eq!(count(&db, 1), 2);
+    assert!(matches!(
+        db.prefix_cardinality::<Row>("category,id", &[]),
+        Err(Error::InvalidQuery)
+    ));
+    assert!(
+        db.prefix_cardinality::<Row>("category,id", &[1_u8.into()])
+            .is_err()
+    );
+    assert!(
+        db.prefix_cardinality::<Row>("score", &[1_u64.into()])
+            .is_err()
+    );
+}
+#[test]
+fn bad_counts_refuse_before_mutation_and_old_format_refuses() {
+    for case in 0..5 {
+        let memory = VectorMemory::default();
+        let h = host(memory.clone());
+        let mut db = create(&h);
+        let mut b = Batch::new();
+        b.insert(&Row {
+            id: 1,
+            category: 1,
+            score: 1,
+        })
+        .unwrap();
+        db.commit(b).unwrap();
+        drop(db);
+        let mut map =
+            StableBTreeMap::<Vec<u8>, Vec<u8>, _>::load(h.open_memory(&key(false)).unwrap());
+
+        match case {
+            0 => {
+                map.insert(raw_key(1), u64::MAX.to_le_bytes().to_vec());
+            }
+            1 => {
+                map.remove(&raw_key(1));
+            }
+            2 => {
+                map.insert(raw_key(1), vec![1]);
+            }
+            3 => {
+                map.insert(raw_key(1), 0_u64.to_le_bytes().to_vec());
+            }
+            _ => {
+                let mut manifest = map.get(&vec![0]).unwrap();
+                manifest[..8].copy_from_slice(b"ICDBMF02");
+                map.insert(vec![0], manifest);
+            }
+        }
+        drop(map);
+        let before = memory.borrow().clone();
+        let result = Database::open(h.open_memory(&key(false)).unwrap(), schema());
+        if case == 4 {
+            assert!(matches!(result, Err(Error::IncompatibleSchema)));
+        } else {
+            let mut db = result.unwrap();
+            let mut b = Batch::new();
+            if case == 1 {
+                b.delete::<Row>(1).unwrap();
+            } else {
+                b.insert(&Row {
+                    id: 2,
+                    category: 1,
+                    score: 2,
+                })
+                .unwrap();
+            }
+            assert!(matches!(db.commit(b), Err(Error::Corrupt | Error::Limit)));
+        }
+        assert_eq!(*memory.borrow(), before);
+    }
+}
+#[test]
+fn high_cardinality_space_is_explicit_and_zero_entries_are_removed() {
+    let memory = VectorMemory::default();
+    let h = host(memory);
+    let mut db = create(&h);
+    for start in (0..512).step_by(32) {
+        let mut b = Batch::new();
+        for id in start..start + 32 {
+            b.insert(&Row {
+                id,
+                category: id,
+                score: id,
+            })
+            .unwrap();
+        }
+        db.commit(b).unwrap();
+    }
+    for id in 0..512 {
+        assert_eq!(count(&db, id), 1);
+    }
+    drop(db);
+    let entries = counters(&h, false);
+    assert_eq!(entries.len(), 512);
+    assert_eq!(
+        entries
+            .iter()
+            .map(|(k, v)| k.len() + v.len())
+            .sum::<usize>(),
+        12800
+    );
+    let mut db = Database::open(h.open_memory(&key(false)).unwrap(), schema()).unwrap();
+    for start in (0..512).step_by(32) {
+        let mut b = Batch::new();
+        for id in start..start + 32 {
+            b.delete::<Row>(id).unwrap();
+        }
+        db.commit(b).unwrap();
+    }
+    drop(db);
+    assert!(counters(&h, false).is_empty());
+}
+#[test]
+fn copy_rebuilds_changed_prefixes_across_chunks_and_reopen() {
+    let memory = VectorMemory::default();
+    let h = host(memory);
+    let mut db = create(&h);
+    let mut b = Batch::new();
+    for id in 1..=7 {
+        b.insert(&Row {
+            id,
+            category: id % 2,
+            score: id,
+        })
+        .unwrap();
+    }
+    db.commit(b).unwrap();
+    let target = Schema::new(&[Wide::SCHEMA]).unwrap();
+    let transition = SchemaTransition::new(&schema(), &target, "prefix-shift", 1, &[]).unwrap();
+    let copy = db
+        .begin_maintenance(&transition)
+        .unwrap()
+        .begin_copy(
+            h.open_memory(&key(true)).unwrap(),
+            schema(),
+            target.clone(),
+            [2; 16],
+        )
+        .unwrap();
+    drop(copy);
+    loop {
+        let mut copy = SchemaCopy::resume(
+            h.open_memory(&key(false)).unwrap(),
+            h.open_memory(&key(true)).unwrap(),
+            schema(),
+            target.clone(),
+            &transition,
+        )
+        .unwrap();
+        if copy
+            .copy_next::<Row, Wide>(2, 4096, |r, _| {
+                Ok(Wide {
+                    id: r.id,
+                    category: r.category + 100,
+                    score: u128::from(r.score),
+                })
+            })
+            .unwrap()
+            .complete
+        {
+            break;
+        }
+    }
+    loop {
+        let mut copy = SchemaCopy::resume(
+            h.open_memory(&key(false)).unwrap(),
+            h.open_memory(&key(true)).unwrap(),
+            schema(),
+            target.clone(),
+            &transition,
+        )
+        .unwrap();
+        if copy.validate_next(2).unwrap() {
+            copy.publish().unwrap();
+            break;
+        }
+    }
+    let db = Database::open(h.open_memory(&key(true)).unwrap(), target).unwrap();
+    assert_eq!(
+        db.prefix_cardinality::<Wide>("category,id", &[100_u64.into()])
+            .unwrap(),
+        3
+    );
+    assert_eq!(
+        db.prefix_cardinality::<Wide>("category,id", &[101_u64.into()])
+            .unwrap(),
+        4
+    );
+    assert_eq!(
+        db.prefix_cardinality::<Wide>("category,id", &[1_u64.into()])
+            .unwrap(),
+        0
+    );
+    drop(db);
+    assert_eq!(
+        counters(&h, true),
+        vec![
+            (raw_key(100), 3_u64.to_le_bytes().to_vec()),
+            (raw_key(101), 4_u64.to_le_bytes().to_vec())
+        ]
+    );
+}
