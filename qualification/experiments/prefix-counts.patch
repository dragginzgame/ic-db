+//! Disposable candidate: exact stable first-component counters for selected Nat64 indexes.
+//! Not an adopted format/API or a general optional cardinality cache.
+use super::{
+    Database, Entity, EntitySchema, Error, FieldType, IndexValue, Map, StoreKey, admit_index_prefix,
+};
+use crate::IndexSchema;
+use ic_storage::Memory;
+use std::collections::{BTreeMap, BTreeSet};
+
+fn eligible(entity: &EntitySchema, index: &IndexSchema) -> bool {
+    index.fields.len() >= 2
+        && index.fields[0] != entity.primary_key
+        && entity.fields.iter().any(|field| {
+            field.name == index.fields[0] && !field.optional && field.value == FieldType::Nat64
+        })
+}
+fn decode(bytes: &[u8]) -> Result<u64, Error> {
+    let value = u64::from_le_bytes(bytes.try_into().map_err(|_| Error::Corrupt)?);
+    if value == 0 {
+        return Err(Error::Corrupt);
+    }
+    Ok(value)
+}
+impl<M: Memory> Database<M> {
+    /// Experimental metadata-only count for one required Nat64 leading component.
+    /// # Errors
+    /// Refuses unsupported prefix shapes/types or malformed stored counters.
+    pub fn prefix_cardinality<E: Entity>(
+        &self,
+        index: &str,
+        values: &[IndexValue<'_>],
+    ) -> Result<u64, Error> {
+        let entity = self.schema.admits(E::SCHEMA)?;
+        let index = entity
+            .indexes
+            .iter()
+            .find(|i| i.name == index)
+            .ok_or(Error::InvalidQuery)?;
+        if values.len() != 1 || !eligible(entity, index) {
+            return Err(Error::InvalidQuery);
+        }
+        let mut bytes = admit_index_prefix(entity, index, values)?;
+        bytes[0] = 4;
+        self.map
+            .get(&StoreKey::new(bytes)?)
+            .map_or(Ok(0), |bytes| decode(&bytes))
+    }
+}
+pub(super) fn delta(
+    entity: &EntitySchema,
+    key: &StoreKey,
+    change: i64,
+    deltas: &mut BTreeMap<StoreKey, i64>,
+) -> Result<(), Error> {
+    let id = u32::from_be_bytes(
+        key.get(5..9)
+            .ok_or(Error::Corrupt)?
+            .try_into()
+            .map_err(|_| Error::Corrupt)?,
+    );
+    let index = entity
+        .indexes
+        .iter()
+        .find(|i| i.id == id)
+        .ok_or(Error::Corrupt)?;
+    if !eligible(entity, index) {
+        return Ok(());
+    }
+    let mut bytes = key.get(..17).ok_or(Error::Corrupt)?.to_vec();
+    bytes[0] = 4;
+    *deltas.entry(StoreKey::new(bytes)?).or_default() += change;
+    Ok(())
+}
+pub(super) fn prepare<M: Memory>(
+    map: &Map<M>,
+    deltas: BTreeMap<StoreKey, i64>,
+    removes: &mut BTreeSet<StoreKey>,
+    writes: &mut BTreeMap<StoreKey, Vec<u8>>,
+) -> Result<(), Error> {
+    for (key, delta) in deltas {
+        if delta == 0 {
+            continue;
+        }
+        let old = map.get(&key).map_or(Ok(0), |bytes| decode(&bytes))?;
+        let count = if delta > 0 {
+            old.checked_add(delta as u64).ok_or(Error::Limit)?
+        } else {
+            old.checked_sub((-delta) as u64).ok_or(Error::Corrupt)?
+        };
+        if count == 0 {
+            removes.insert(key);
+        } else {
+            writes.insert(key, count.to_le_bytes().to_vec());
+        }
+    }
+    Ok(())
+}
+pub(super) fn validate_record(
+    entity: &EntitySchema,
+    key: &StoreKey,
+    bytes: &[u8],
+) -> Result<(), Error> {
+    if key.len() != 17 {
+        return Err(Error::Corrupt);
+    }
+    let id = u32::from_be_bytes(key[5..9].try_into().map_err(|_| Error::Corrupt)?);
+    let index = entity
+        .indexes
+        .iter()
+        .find(|i| i.id == id)
+        .ok_or(Error::Corrupt)?;
+    if !eligible(entity, index) {
+        return Err(Error::Corrupt);
+    }
+    decode(bytes)?;
+    Ok(())
+}
