+    /// Remove the existing keys in the supplied set and return the number removed.
+    pub fn remove_many(&mut self, keys: std::collections::BTreeSet<K>) -> u64 {
+        let original_len = self.len();
+        let mut pending = keys.into_iter().peekable();
+        while let Some(key) = pending.next() {
+            if self.root_addr == NULL {
+                break;
+            }
+            let root = self.load_node(self.root_addr);
+            self.remove_run(root, &key, Some(&mut pending));
+        }
+        original_len - self.len()
+    }
